# Copy to .env and adjust. Never commit .env (see .gitignore).
# All settings use the NLP_ prefix (pydantic-settings).

# Trained intent artifacts directory (created by training CLI).
NLP_MODEL_DIR=models

# Project dataset CSV and its schema (required before training works).
NLP_DATASET_PATH=data/raw/intents.csv
NLP_DATASET_TEXT_COL=text
NLP_DATASET_LABEL_COL=intent
# NLP_DATASET_ENTITY_COL=entities

# Upload cap in bytes (default 10485760 = 10 MiB).
# NLP_MAX_FILE_SIZE_BYTES=10485760

# Allowed frontend origins (comma-separated, parsed as JSON list in shell
# exports is NOT supported; override in code or deployment config).
# NOTE: pydantic-settings parses list fields from JSON, e.g.
# NLP_FRONTEND_ORIGINS='["http://localhost:3000"]'

# English translation via GROQ (OpenAI-compatible chat API).
# Get a key at https://console.groq.com/keys -- keep it in .env only.
# NLP_GROQ_API_KEY=gsk_...
# NLP_GROQ_MODEL=qwen/qwen3.8-27b
# NLP_GROQ_TIMEOUT_S=30.0
